{
  "Sid": "AllowPatchOutcomeWritersFromOrg",
  "Effect": "Allow",
  "Principal": "*",
  "Action": [
    "s3:PutObject"
  ],
  "Resource": "arn:aws:s3:::central-patching-logs-111122223333/patchingsolution-events/outcomes/*",
  "Condition": {
    "StringEquals": {
      "aws:PrincipalOrgID": "o-example1234"
    },
    "ArnLike": {
      "aws:PrincipalArn": "arn:aws:iam::*:role/patch-outcome-s3-writer"
    }
  }
}
