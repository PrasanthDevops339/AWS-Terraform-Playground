{
  "Sid": "AllowPatchOutcomeWritersFromOrg",
  "Effect": "Allow",
  "Principal": "*",
  "Action": [
    "kms:GenerateDataKey",
    "kms:Encrypt",
    "kms:DescribeKey"
  ],
  "Resource": "*",
  "Condition": {
    "StringEquals": {
      "aws:PrincipalOrgID": "o-example1234"
    },
    "ArnLike": {
      "aws:PrincipalArn": "arn:aws:iam::*:role/patch-outcome-s3-writer"
    }
  }
}
