{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyUpsolverAMIsOutsideDatalakeAccounts",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateFleet",
        "ec2:RequestSpotInstances"
      ],
      "Resource": "arn:aws:ec2:*::image/*",
      "Condition": {
        "StringEquals": {
          "ec2:Owner": "428641199958"
        },
        "StringNotEquals": {
          "aws:PrincipalAccount": [
            "100000000001",
            "100000000002",
            "100000000003"
          ]
        }
      }
    },
    {
      "Sid": "DenyMarketplaceTransitAMIsOutsideTransitAccounts",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateFleet",
        "ec2:RequestSpotInstances"
      ],
      "Resource": "arn:aws:ec2:*::image/*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "ec2:ProductCode": [
            "6dcndlpi3tu6z8ten76nuejp",
            "a8sxy6easi2zumgtyr564z6y7",
            "akjez2r6bd6o7tg3mhptif6ti",
            "7u0lnfhluv0k8cyewctn0xdx8",
            "cmudow1tph9k98mz0ctkc063w"
          ]
        },
        "StringNotEquals": {
          "aws:PrincipalAccount": [
            "200000000001",
            "200000000002",
            "200000000003"
          ]
        }
      }
    }
  ]
}
